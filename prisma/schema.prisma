datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password_hash String
  role_id       Int
  role          Role           @relation(fields: [role_id], references: [id])
  status        String         @default("ACTIVE")
  last_login    DateTime?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  auditLogs     AuditLog[]
  assignedRegs  StudentRegistration[] @relation("AssignedRegs")
  assignedEnquiries CourseEnquiry[] @relation("AssignedEnquiries")
  assignedContacts ContactMessage[] @relation("AssignedContacts")
  assignedCorp  CorporateLead[]  @relation("AssignedCorp")
  assignedFran  FranchiseLead[]  @relation("AssignedFran")
  blogs         Blog[]
  media         Media[]

  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  created_at      DateTime         @default(now())
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            Int        @id @default(autoincrement())
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model CourseCategory {
  id          Int                 @id @default(autoincrement())
  name        String
  slug        String              @unique
  description String?
  status      String              @default("ACTIVE")
  mappings    CourseCategoryMap[]

  @@map("course_categories")
}

model Course {
  id                   Int                  @id @default(autoincrement())
  title                String
  slug                 String               @unique
  short_description    String
  long_description     String
  duration             String
  certification        String
  placement_assistance String               @default("Yes")
  online_available     Boolean              @default(true)
  classroom_available  Boolean              @default(true)
  hero_image           String?
  brochure_url         String?
  status               String               @default("PUBLISHED")
  seo_title            String?
  seo_description      String?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  categories           CourseCategoryMap[]
  curriculum           CourseCurriculum[]
  tools                CourseTool[]
  mentors              CourseMentor[]
  careers              CourseCareer[]
  projects             CourseProject[]
  faqs                 Faq[]
  registrations        StudentRegistration[]
  enquiries            CourseEnquiry[]
  alumni               Alumni[]
  placements           Placement[]
  testimonials         Testimonial[]

  @@map("courses")
}

model CourseCategoryMap {
  id          Int            @id @default(autoincrement())
  course_id   Int
  category_id Int
  course      Course         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  category    CourseCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([course_id, category_id])
  @@map("course_category_map")
}

model CourseCurriculum {
  id          Int      @id @default(autoincrement())
  course_id   Int
  title       String
  description String
  duration    String?
  sort_order  Int      @default(0)
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("course_curriculum")
}

model CourseTool {
  id          Int      @id @default(autoincrement())
  course_id   Int
  tool_name   String
  tool_icon   String?
  description String?
  sort_order  Int      @default(0)
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("course_tools")
}

model CourseMentor {
  id           Int      @id @default(autoincrement())
  course_id    Int
  mentor_name  String
  mentor_image String?
  designation  String
  bio          String?
  sort_order   Int      @default(0)
  course       Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("course_mentors")
}

model CourseCareer {
  id          Int      @id @default(autoincrement())
  course_id   Int
  career_name String
  industry    String?
  description String?
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("course_careers")
}

model CourseProject {
  id          Int      @id @default(autoincrement())
  course_id   Int
  title       String
  description String?
  image_url   String?
  video_url   String?
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("course_projects")
}

model Faq {
  id         Int      @id @default(autoincrement())
  course_id  Int?
  question   String
  answer     String
  sort_order Int      @default(0)
  status     String   @default("ACTIVE")
  course     Course?  @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("faqs")
}

model StudentRegistration {
  id              Int      @id @default(autoincrement())
  name            String
  father_name     String?
  gender          String
  education       String
  email           String
  phone           String
  alternate_phone String?
  course_id       Int
  course          Course   @relation(fields: [course_id], references: [id])
  address1        String
  address2        String?
  city            String
  state           String
  country         String   @default("India")
  status          String   @default("New")
  admin_notes     String?
  assigned_to     Int?
  assignee        User?    @relation("AssignedRegs", fields: [assigned_to], references: [id])
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("student_registrations")
}

model CourseEnquiry {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  course_id   Int
  course      Course   @relation(fields: [course_id], references: [id])
  message     String?
  status      String   @default("New")
  assigned_to Int?
  assignee    User?    @relation("AssignedEnquiries", fields: [assigned_to], references: [id])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("course_enquiries")
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  mobile      String
  message     String
  consent     Boolean  @default(true)
  status      String   @default("New")
  admin_notes String?
  assigned_to Int?
  assignee    User?    @relation("AssignedContacts", fields: [assigned_to], references: [id])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("contact_messages")
}

model CorporateLead {
  id                 Int      @id @default(autoincrement())
  company_name       String
  contact_name       String
  phone              String
  email              String
  program            String
  estimated_trainees Int?
  course_timeline    String?
  message            String?
  status             String   @default("New")
  assigned_to        Int?
  assignee           User?    @relation("AssignedCorp", fields: [assigned_to], references: [id])
  admin_notes        String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("corporate_leads")
}

model FranchiseLead {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  email       String
  company     String?
  location    String
  message     String?
  status      String   @default("New")
  assigned_to Int?
  assignee    User?    @relation("AssignedFran", fields: [assigned_to], references: [id])
  admin_notes String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("franchise_leads")
}

model StudentWorkCategory {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String        @unique
  studentWorks StudentWork[]

  @@map("student_work_categories")
}

model StudentWork {
  id           Int                 @id @default(autoincrement())
  title        String
  student_name String
  category_id  Int
  category     StudentWorkCategory @relation(fields: [category_id], references: [id])
  description  String?
  image_url    String?
  video_url    String?
  featured     Boolean             @default(false)
  status       String              @default("PUBLISHED")
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  @@map("student_works")
}

model Alumni {
  id              Int      @id @default(autoincrement())
  name            String
  photo           String?
  course_id       Int?
  course          Course?  @relation(fields: [course_id], references: [id])
  designation     String
  company         String
  graduation_year Int?
  story           String?
  featured        Boolean  @default(false)
  status          String   @default("PUBLISHED")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("alumni")
}

model Placement {
  id            Int      @id @default(autoincrement())
  student_name  String
  student_photo String?
  course_id     Int?
  course        Course?  @relation(fields: [course_id], references: [id])
  job_title     String
  company       String
  company_logo  String?
  year          Int
  description   String?
  status        String   @default("PUBLISHED")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("placements")
}

model Testimonial {
  id          Int      @id @default(autoincrement())
  name        String
  photo       String?
  course_id   Int?
  course      Course?  @relation(fields: [course_id], references: [id])
  designation String?
  company     String?
  testimonial String
  rating      Int      @default(5)
  featured    Boolean  @default(false)
  status      String   @default("PUBLISHED")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("testimonials")
}

model BlogCategory {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  blogs       Blog[]

  @@map("blog_categories")
}

model Blog {
  id              Int          @id @default(autoincrement())
  title           String
  slug            String       @unique
  excerpt         String?
  content         String
  featured_image  String?
  category_id     Int
  category        BlogCategory @relation(fields: [category_id], references: [id])
  author_id       Int?
  author          User?        @relation(fields: [author_id], references: [id])
  tags            String?
  seo_title       String?
  seo_description String?
  published       Boolean      @default(true)
  published_at    DateTime     @default(now())
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("blogs")
}

model Media {
  id          Int      @id @default(autoincrement())
  filename    String
  url         String
  type        String
  mime_type   String
  size        Int
  alt_text    String?
  folder      String?  @default("general")
  uploaded_by Int?
  uploader    User?    @relation(fields: [uploaded_by], references: [id])
  created_at  DateTime @default(now())

  @@map("media")
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt

  @@map("settings")
}

model SeoMetadata {
  id             Int      @id @default(autoincrement())
  page           String   @unique
  title          String
  description    String
  keywords       String?
  canonical_url  String?
  og_title       String?
  og_description String?
  og_image       String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("seo_metadata")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  user       User?    @relation(fields: [user_id], references: [id])
  action     String
  entity     String
  entity_id  Int?
  ip_address String?
  created_at DateTime @default(now())

  @@map("audit_logs")
}
