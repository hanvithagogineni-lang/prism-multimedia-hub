2:["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 space-y-10","children":[["$","div",null,{"className":"text-center max-w-3xl mx-auto space-y-3","children":[["$","span",null,{"className":"text-xs font-bold text-prism-orange uppercase tracking-widest","children":"Master Studio Skills"}],["$","h1",null,{"className":"text-4xl font-extrabold text-white sm:text-5xl","children":"Our Professional Courses"}],["$","p",null,{"className":"text-prism-muted text-base","children":"From 3-month short-term skill accelerators to 18-month flagship Master Diplomas across Graphic Design, UX/UI, 2D/3D Animation, Video Editing, VFX, and Digital Media."}]]}],["$","$L8",null,{"courses":[{"id":"c1","title":"Graphic Design","slug":"graphic-design","short_description":"Master visual communication, vector illustration, photo manipulation, and brand identity design.","description":"Comprehensive professional training covering typography, color theory, advertising design, logo branding, and print production workflows.","duration":"3 Months","category":"Design","eligibility":"10th / 12th / Any Graduate with passion for visual creativity.","certification":"Certified Graphic Designer Certificate from Prism Multimedia Institute.","career_opportunities":["Graphic Designer","Brand Identity Specialist","Layout Artist","Visual Designer","Packaging Designer"],"learning_modes":["Classroom Hands-on Studio","Online Live Interactive Sessions"],"mentors":["Kiran P","Ali MD","Dayakar"],"software_tools":["Adobe Photoshop","Adobe Illustrator","Adobe Acrobat","CorelDRAW"],"fees":"₹25,000","featured":true,"image_url":"https://images.unsplash.com/photo-1626785774573-4b799315345d?auto=format&fit=crop&w=800&q=80","modules":[{"id":"m1","course_id":"c1","module_name":"Design Fundamentals & Color Theory","description":"Color harmony, composition grids, typography rules","display_order":1},{"id":"m2","course_id":"c1","module_name":"Vector Illustration with Illustrator","description":"Pen tool mastery, logo design, iconography, branding kits","display_order":2},{"id":"m3","course_id":"c1","module_name":"Photo Manipulation with Photoshop","description":"Layer masking, digital retouching, matte painting, color grading","display_order":3},{"id":"m4","course_id":"c1","module_name":"Print & Commercial Layout Publishing","description":"Pre-press preparation, brochure design, packaging mockups","display_order":4}]},{"id":"c2","title":"UX Design","slug":"ux-design","short_description":"User research, wireframing, information architecture, and usability testing.","description":"Master end-to-end user experience design methodology, persona building, user journey mapping, interactive wireframing, and usability heuristics.","duration":"4 Months","category":"Product Design","eligibility":"10+2 / Graduates / IT Professionals looking to transition to Product Design.","certification":"UX Design Specialist Certificate.","career_opportunities":["UX Researcher","Information Architect","UX Designer","Product Strategist"],"learning_modes":["Classroom Project Studio","Live Online Workshops"],"mentors":["Anjee Yarlagadda","Prem N"],"software_tools":["Figma","Adobe XD","Miro","Balsamiq"],"fees":"₹35,000","featured":true,"image_url":"https://images.unsplash.com/photo-1581291518633-83b4ebd1d83e?auto=format&fit=crop&w=800&q=80","modules":[{"id":"m5","course_id":"c2","module_name":"User Research & Discovery","description":"User interviews, competitive analysis, affinity mapping","display_order":1},{"id":"m6","course_id":"c2","module_name":"Information Architecture & Wireframing","description":"User flows, site maps, low-fidelity wireframes","display_order":2},{"id":"m7","course_id":"c3","module_name":"Usability Testing & Iteration","description":"Usability testing, accessibility standards, design systems","display_order":3}]},{"id":"c3","title":"UI Design & Development","slug":"ui-design-and-development","short_description":"Modern front-end interface design, responsive layouts, HTML, CSS, JavaScript & Bootstrap.","description":"Bridge the gap between design and web code. Learn interactive interface prototyping, atomic design systems, responsive flexbox/grid layouts, HTML5, CSS3, JavaScript, and Bootstrap.","duration":"5 Months","category":"Web & UI","eligibility":"10+2 / Any Graduate / Computer Science students.","certification":"Certified UI Designer & Front-End Developer.","career_opportunities":["UI Designer","Front-End Web Developer","Web Interface Engineer","Design System Specialist"],"learning_modes":["Classroom Code Lab","Online Live Sessions"],"mentors":["Omkar","Ravi Kumar","Dayakar"],"software_tools":["Figma","HTML","CSS","JavaScript","Bootstrap","jQuery","Angular"],"fees":"₹40,000","featured":true,"image_url":"https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=800&q=80","modules":[{"id":"m8","course_id":"c3","module_name":"Visual UI Design & Prototyping","description":"Design tokens, dark mode UI, micro-interactions","display_order":1},{"id":"m9","course_id":"c3","module_name":"HTML5 & Modern CSS3 Layouts","description":"Flexbox, Grid, CSS animations, responsive breakpoints","display_order":2},{"id":"m10","course_id":"c3","module_name":"JavaScript & Interactive Frameworks","description":"DOM manipulation, AJAX, Bootstrap 5, Angular components","display_order":3}]},{"id":"c4","title":"Digital Marketing","slug":"digital-marketing","short_description":"SEO, Social Media Marketing, PPC, Content Strategy, and Analytics.","description":"Comprehensive digital growth strategies covering Search Engine Optimization, Google Ads (SEM), Meta Ads, Email Marketing, Content Strategy, and Google Analytics 4.","duration":"3 Months","category":"Marketing","eligibility":"Any Graduate / Marketers / Entrepreneurs.","certification":"Certified Digital Marketing Professional.","career_opportunities":["Digital Marketing Executive","SEO Specialist","PPC Campaign Manager","Social Media Manager"],"learning_modes":["Classroom Studio","Online Live"],"mentors":["Lakshmi","Anjee Yarlagadda"],"software_tools":["Google Ads","Meta Ads Manager","SEMrush","Google Analytics 4","Canva"],"fees":"₹30,000","featured":true,"image_url":"https://images.unsplash.com/photo-1533750516457-a7f992034fec?auto=format&fit=crop&w=800&q=80","modules":[{"id":"m11","course_id":"c4","module_name":"SEO & Keyword Strategy","description":"On-page SEO, technical audits, backlink building","display_order":1},{"id":"m12","course_id":"c4","module_name":"Performance Marketing & Paid Ads","description":"Google Search Ads, Meta Reels campaigns, ROI optimization","display_order":2}]},{"id":"c5","title":"2D Animation","slug":"2d-animation","short_description":"Character design, classical animation principles, digital storyboarding and vector animation.","description":"Learn classical 12 principles of animation, character rigging, lip-syncing, background painting, and vector animation using Adobe Animate and Clip Studio.","duration":"5 Months","category":"Animation","eligibility":"10th / 12th / Fine Arts students.","certification":"2D Animation Specialist Certificate.","career_opportunities":["2D Animator","Storyboard Artist","Character Designer","Clean-up Artist"],"learning_modes":["Classroom Lab"],"mentors":["Mr. Ramesh","K. Ravindra","Kiran P","Rama Krishna"],"software_tools":["Adobe Animate","Photoshop","Storyboad Pro","After Effects"],"fees":"₹38,000","featured":false,"image_url":"https://images.unsplash.com/photo-1541961017774-22349e4a1262?auto=format&fit=crop&w=800&q=80","modules":[{"id":"m13","course_id":"c5","module_name":"Animation Principles & Storyboarding","description":"Squash & stretch, timing, keyframing","display_order":1},{"id":"m14","course_id":"c5","module_name":"Character Rigging & Motion","description":"Bone tools, lip sync, walk cycles","display_order":2}]},{"id":"c6","title":"3D Animation","slug":"3d-animation","short_description":"3D Modeling, Texturing, Rigging, Lighting, Animation, and Rendering with Maya & Blender.","description":"Master 3D digital pipelines for gaming, television, and film. Learn polygon modeling, UV unwrapping, PBR texturing, biped rigging, 3D character animation, Arnold rendering, and Blender.","duration":"6 Months","category":"Animation","eligibility":"10+2 / Any Graduate.","certification":"Master in 3D Animation Certificate.","career_opportunities":["3D Animator","3D Modeler","Rigging Artist","Lighting & Texturing Artist"],"learning_modes":["Classroom High-End Workstation Studio"],"mentors":["Kiran P","Rajesh Kumar","Nageswararao"],"software_tools":["Autodesk Maya","Blender","Substance Painter","ZBrush","Arnold"],"fees":"₹50,000","featured":true,"image_url":"https://images.unsplash.com/photo-1617791160588-241658c0f566?auto=format&fit=crop&w=800&q=80","modules":[{"id":"m15","course_id":"c6","module_name":"3D Poly Modeling & Sculpting","description":"Character & prop modeling in Maya and Blender","display_order":1},{"id":"m16","course_id":"c6","module_name":"3D Character Rigging & Animation","description":"Skeleton setups, IK/FK controls, 3D performance animation","display_order":2}]},{"id":"c7","title":"Audio & Video Editing","slug":"audio-video-editing","short_description":"Post-production editing, color grading, multitrack audio mixing, and video finishing.","description":"Professional video post-production workflow. Master Premiere Pro, DaVinci Resolve color correction, audio restoration with Adobe Audition, and broadcast video encoding.","duration":"3 Months","category":"Editing","eligibility":"10th / 12th / Mass Communication students.","certification":"Certified Video & Audio Editor.","career_opportunities":["Video Editor","Colorist","Sound Mixer","Post-Production Specialist"],"learning_modes":["Classroom Studio Lab"],"mentors":["Srinivas","Sandeep Goud","Krishna"],"software_tools":["Adobe Premiere Pro","Adobe Audition","DaVinci Resolve","Adobe Media Encoder"],"fees":"₹28,000","featured":true,"image_url":"https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=800&q=80","modules":[{"id":"m17","course_id":"c7","module_name":"Non-Linear Video Editing","description":"Trimming, multi-cam editing, audio syncing","display_order":1},{"id":"m18","course_id":"c7","module_name":"Color Grading & Audio Mastering","description":"LUTs, scopes, noise reduction, stereo mixing","display_order":2}]},{"id":"c8","title":"VFX (Visual Effects)","slug":"vfx","short_description":"Chroma keying, roto, matchmoving, 3D compositing, and particle simulation.","description":"Comprehensive visual effects course covering green screen extraction, rotoscoping, camera tracking, particle simulation, explosions, and 3D compositing in After Effects and Nuke.","duration":"8 Months","category":"VFX","eligibility":"10+2 / Any Graduate.","certification":"Master Visual Effects Artist Certificate.","career_opportunities":["Compositing Artist","Roto Artist","Matchmove Specialist","VFX Supervisor"],"learning_modes":["Classroom High-End VFX Workstations"],"mentors":["Sai Ram","Anjee Yarlagadda","Rama Krishna","Yasu Babu"],"software_tools":["Adobe After Effects","Foundry Nuke","Mocha Pro","Maya VFX","Photoshop"],"fees":"₹65,000","featured":true,"image_url":"https://images.unsplash.com/photo-1478720568477-152d9b164e26?auto=format&fit=crop&w=800&q=80","modules":[{"id":"m19","course_id":"c8","module_name":"Rotoscoping & Paint","description":"Silhouette extraction, frame-by-frame clean-up","display_order":1},{"id":"m20","course_id":"c8","module_name":"Chroma Keying & 3D Compositing","description":"Keylight, camera tracking, light wrap, depth compositing","display_order":2}]},{"id":"c9","title":"Motion Graphics","slug":"motion-graphics","short_description":"Animated typography, 2D/3D visual effects, promo design, and broadcast graphics.","description":"Combine graphic design principles with animation techniques. Create animated logos, promo intros, title sequences, infographics, and UI micro-animations.","duration":"4 Months","category":"Motion","eligibility":"10+2 / Graphic Designers looking to add motion skills.","certification":"Motion Graphics Designer Certificate.","career_opportunities":["Motion Designer","Broadcast Graphics Artist","Title Sequence Designer","Promo Creator"],"learning_modes":["Classroom Studio","Online Live"],"mentors":["Dayakar","Srinivasa Rao","Anil B","Rama Krishna"],"software_tools":["Adobe After Effects","Adobe Illustrator","Adobe Photoshop","Cinema 4D Lite"],"fees":"₹35,000","featured":true,"image_url":"https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=800&q=80","modules":[{"id":"m21","course_id":"c9","module_name":"Keyframe Motion & Kinetic Typography","description":"Easing curves, speed graphs, animated headlines","display_order":1},{"id":"m22","course_id":"c9","module_name":"Broadcast Packages & Logo Animations","description":"Lower thirds, stinger transitions, 3D layer motion","display_order":2}]},{"id":"c10","title":"EDP (Executive Development Program)","slug":"edp","short_description":"Practical, project-based development to strengthen creative and technology skills.","description":"Customized hands-on development program tailored for working professionals and career changers needing practical software expertise.","duration":"6 Months","category":"Professional","eligibility":"Graduates / Working Executives.","certification":"Executive Development Diploma.","career_opportunities":["Creative Lead","Digital Media Executive","Project Coordinator"],"learning_modes":["Classroom Flexible Timings","Weekend Batches"],"mentors":["Kiran P","Rajesh Kumar","Nageswararao"],"software_tools":["Photoshop","Illustrator","Premiere Pro","HTML/CSS"],"fees":"₹45,000","featured":false,"image_url":"https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80","modules":[]},{"id":"c11","title":"GDIM (Graduate Diploma in Interactive Multimedia)","slug":"gdim","short_description":"Comprehensive 10-month program covering Graphic Design, UI Design, Video Editing & Motion Graphics.","description":"Multi-disciplinary diploma covering graphic design, UI responsive development, audio-video post-production, and motion graphics.","duration":"10 Months","category":"Diploma","eligibility":"10+2 / Any Graduate.","certification":"Graduate Diploma in Interactive Multimedia.","career_opportunities":["Multimedia Specialist","Creative Designer","Front-End UI Specialist","Video & Motion Producer"],"learning_modes":["Classroom Full-Time Studio"],"mentors":["Kiran P","Anjee Yarlagadda","Omkar","Dayakar"],"software_tools":["Photoshop","Illustrator","HTML/CSS","Bootstrap","Premiere Pro","After Effects"],"fees":"₹75,000","featured":true,"image_url":"https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=800&q=80","modules":[]},{"id":"c12","title":"PGDIM (Post Graduate Diploma in Interactive Multimedia)","slug":"pgdim","short_description":"Flagship 18-month master program across Design, UI/UX, 2D/3D Animation, Video Editing & VFX.","description":"Our ultimate flagship multimedia program. Covers Graphic Design, UI/UX Architecture, 2D & 3D Animation, Video Production, and Visual Effects with full live studio portfolio projects and guaranteed placement support.","duration":"18 Months","category":"Flagship","eligibility":"Graduates / 10+2 with strong passion for creative careers.","certification":"Post Graduate Diploma in Interactive Multimedia.","career_opportunities":["Art Director","Senior UI/UX Lead","3D Production Supervisor","VFX Artist","Multimedia Team Lead"],"learning_modes":["Classroom Full-Time Live Studio"],"mentors":["M. Srinivas Rao","Anjee Yarlagadda","Kiran P","Rajesh Kumar","Sai Ram"],"software_tools":["Adobe Photoshop","Adobe Illustrator","HTML5","CSS3","JavaScript","Bootstrap","jQuery","Angular","Adobe Animate","Adobe Premiere Pro","Adobe After Effects","Adobe Media Encoder","Adobe Audition","Autodesk Maya","Blender"],"fees":"₹1,20,000","featured":true,"image_url":"https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=800&q=80","modules":[]}]}]]}]
