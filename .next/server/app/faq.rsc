2:["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 space-y-10","children":[["$","div",null,{"className":"text-center space-y-3","children":[["$","span",null,{"className":"text-xs font-bold text-prism-orange uppercase tracking-widest","children":"Help Center"}],["$","h1",null,{"className":"text-4xl font-extrabold text-white sm:text-5xl","children":"Frequently Asked Questions"}],["$","p",null,{"className":"text-prism-muted text-base","children":"Find answers regarding admissions, course durations, beginner eligibility, online batches, and placement support."}]]}],["$","$L8",null,{"faqs":[{"id":"faq1","question":"What courses does Prism Multimedia offer?","answer":"Prism Multimedia offers professional diploma and certificate courses in Graphic Design, UX Design, UI Design & Development, Digital Marketing, 2D Animation, 3D Animation, Audio & Video Editing, VFX (Visual Effects), EDP, GDIM, and PGDIM.","category":"Courses","display_order":1},{"id":"faq2","question":"Why should I choose Prism Multimedia for multimedia training?","answer":"Prism Multimedia is an enterprise run by experienced professionals with over 24+ years of hands-on industry experience. We provide 100% placement support, certified faculty, state-of-the-art studio workstations, and live project training.","category":"General","display_order":2},{"id":"faq3","question":"Are the courses at Prism Multimedia suitable for beginners?","answer":"Yes! All our courses start from basic fundamental principles and progress step-by-step to advanced professional studio workflows.","category":"Courses","display_order":3},{"id":"faq4","question":"How can I enroll in a course at Prism Multimedia?","answer":"You can register online by clicking the \"Register Now\" button on our website, or visit our Ameerpet center in Hyderabad for counseling.","category":"Admissions","display_order":4},{"id":"faq5","question":"What are the benefits of studying at Prism Multimedia?","answer":"Benefits include hands-on practical assignments, professional portfolio creation, 100% placement assistance, certified master trainers, and industry networking.","category":"General","display_order":5},{"id":"faq6","question":"Can I find job opportunities through Prism Multimedia?","answer":"Yes! We have a dedicated placement assistance cell that connects students with top agencies, IT firms, game studios, and production houses across India.","category":"Placements","display_order":6},{"id":"faq7","question":"How do I download the E-Brochure for Prism Multimedia?","answer":"Click the \"Download E-Brochure\" button on the navigation bar or hero section to instantly view and download our official program guide.","category":"General","display_order":7},{"id":"faq8","question":"What is the duration of the multimedia courses?","answer":"Course durations range from 3 months (Short-term Certificate courses) to 18 months (PGDIM Flagship Diploma).","category":"Courses","display_order":8},{"id":"faq9","question":"Are there any online options available for the courses?","answer":"Yes, we offer both classroom interactive studio batches and live interactive online training sessions.","category":"Admissions","display_order":9},{"id":"faq10","question":"How can I contact Prism Multimedia for more information?","answer":"You can reach us by phone at +91 97013 34133 or +91 91775 55040, email info@prismmultimedia.com, or fill out our online Contact Us form.","category":"General","display_order":10}]}]]}]
