2:["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 space-y-10","children":[["$","div",null,{"className":"text-center max-w-3xl mx-auto space-y-3","children":[["$","span",null,{"className":"text-xs font-bold text-prism-orange uppercase tracking-widest","children":"Global Success"}],["$","h1",null,{"className":"text-4xl font-extrabold text-white sm:text-5xl","children":"Our Successful Alumni"}],["$","p",null,{"className":"text-prism-muted text-base","children":"Over 10,000+ graduates placed at World Health Organization, Cognizant, BigTV, Sitara Foods, CyberSRC, Innomagine, and Greengold Animation."}]]}],["$","$L8",null,{"alumni":[{"id":"a1","name":"Bolle Madhu","slug":"bolle-madhu","photo_url":"/alumni-bolle-madhu.jpg","course":"Graphic Design","job_title":"Graphic Designer","company":"Sitara Foods","quote":"Prism Multimedia gave me hands-on practical skills that made my transition into commercial graphic design smooth and confident.","featured":true,"created_at":"2024-01-15"},{"id":"a2","name":"Venkateswara Rao","slug":"venkateswara-rao","photo_url":"/alumni-venkateswara-rao.jpg","course":"Graphic Design","job_title":"Graphic Designer","company":"Chota News","quote":"The faculty at Prism taught me pre-press layout and digital branding workflows used by top agencies.","featured":true,"created_at":"2024-02-10"},{"id":"a3","name":"Maggidi Uday Kiran","slug":"maggidi-uday-kiran","photo_url":"/alumni-maggidi-uday.jpg","course":"Digital Marketing","job_title":"Social Media Executive","company":"BigTV","quote":"From content strategy to creative campaign design, Prism helped me launch my career in social media broadcasting.","featured":true,"created_at":"2024-03-01"},{"id":"a4","name":"Nikhilesh Mishra","slug":"nikhilesh-mishra","photo_url":"/alumni-nikhilesh-mishra.jpg","course":"Digital Marketing","job_title":"Social Media Executive","company":"CyberSRC Consultancy","quote":"The practical campaign assignments and mentor reviews prepared m